          "properties": {
            "Available": {
              "type": "boolean"
            },
            "RequireSigning": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "RequireEncryption": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "InsecureGuestAllowed": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "AuditServerDoesNotSupportSigning": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "AuditServerDoesNotSupportEncryption": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "Server": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Available",
            "RequireSigning",
            "EncryptData",
            "RejectUnencryptedAccess",
            "AuditClientDoesNotSupportSigning",
            "AuditClientDoesNotSupportEncryption"
          ],
          "properties": {
            "Available": {
              "type": "boolean"
            },
            "RequireSigning": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "EncryptData": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "RejectUnencryptedAccess": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "AuditClientDoesNotSupportSigning": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "AuditClientDoesNotSupportEncryption": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "RpcPrivacy",
        "RpcUseNamedPipe",
        "RpcProtocols",
        "RpcTcpPort",
        "ForceKerberosForRpc",
        "RemoteRpcEndpoint",
        "PointAndPrint",
        "GuestAuth",
        "LmCompatibility",
        "BlankPassword"
