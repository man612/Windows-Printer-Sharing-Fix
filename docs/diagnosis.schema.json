        "Reason": {
          "type": "string",
          "minLength": 1
        },
        "RemoteTransportTested": {
          "type": "boolean"
        },
        "Signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "RootCauseClaimed": {
          "const": false
        }
      }
    },
    "printServiceEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "TimeCreatedUtc",
        "Id",
        "Level",
        "Category",
        "Win32Code",
        "CodeClass"
      ],
      "properties": {
        "TimeCreatedUtc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "Id": {
          "type": "integer",
          "minimum": 0
        },
        "Level": {
          "type": "string"
        },
        "Category": {
          "type": "string"
        },
        "Win32Code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "CodeClass": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Severity",
        "Text"
      ],
      "properties": {
        "Severity": {
          "type": "string",
          "minLength": 1
        },
        "Text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "OS",
        "Spooler",
        "Printers",
        "PrinterDrivers",
        "Profiles",
        "WPP",
        "SmbSecurity",
        "PrintEvents",
        "PolicySources",
        "SMB1",
        "Total"
      ],
      "properties": {
        "OS": {
          "type": "integer",
          "minimum": 0
        },
        "Spooler": {
          "type": "integer",
          "minimum": 0
        },
        "Printers": {
          "type": "integer",
          "minimum": 0
        },
        "PrinterDrivers": {
          "type": "integer",
          "minimum": 0
        },
        "Profiles": {
          "type": "integer",
          "minimum": 0
        },
        "WPP": {
          "type": "integer",
          "minimum": 0
        },
        "SmbSecurity": {
          "type": "integer",
          "minimum": 0
        },
        "PrintEvents": {
          "type": "integer",
          "minimum": 0
        },
        "PolicySources": {
          "type": "integer",
          "minimum": 0
        },
        "SMB1": {
          "type": "integer",
          "minimum": 0
        },
        "Total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "targetPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "TestedAtUtc",
        "DnsResolved",
        "Smb445Reachable",
        "Rpc135Reachable",
        "RpcConfiguredPort",
        "RpcConfiguredPortReachable",
        "ShareNamespaceAccessible",
        "PrinterInstalled",
        "SmbSecuritySignals",
        "LikelyLayer"
      ],
      "properties": {
        "TestedAtUtc": {
          "type": "string"
        },
        "DnsResolved": {
          "type": "boolean"
        },
        "Smb445Reachable": {
          "type": "boolean"
        },
        "Rpc135Reachable": {
          "type": "boolean"
        },
        "RpcConfiguredPort": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 65535
        },
        "RpcConfiguredPortReachable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "ShareNamespaceAccessible": {
          "type": "boolean"
        },
        "PrinterInstalled": {
          "type": "boolean"
        },
        "SmbSecuritySignals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "LikelyLayer": {
          "type": "string"
        }
      }
    },
    "functionalVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "VerifiedAtUtc",
        "DiagnosticCollectedAtUtc",
        "RequestStatus",
        "Outcome",
        "NetworkConnection",
        "DriverModel",
        "DriverProviderClass",
        "DriverTechnology"
      ],
      "properties": {
        "VerifiedAtUtc": {
          "type": "string"
        },
        "DiagnosticCollectedAtUtc": {
          "type": "string"
        },
        "RequestStatus": {
          "type": "string"
        },
        "Outcome": {
          "type": "string"
        },
        "NetworkConnection": {
          "type": "boolean"
        },
        "DriverModel": {
          "type": "string"
        },
        "DriverProviderClass": {
          "type": "string"
        },
        "DriverTechnology": {
          "type": "string"
