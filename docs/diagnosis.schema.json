        "Shared": {
          "type": "integer",
          "minimum": 0
        },
        "NetworkConnections": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "driverSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "TotalBindings",
        "Models",
        "Providers",
        "Technologies"
      ],
      "properties": {
        "TotalBindings": {
          "type": "integer",
          "minimum": 0
        },
        "Models": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "V3",
            "V4",
            "Unknown"
          ],
          "properties": {
            "V3": {
              "type": "integer",
              "minimum": 0
            },
            "V4": {
              "type": "integer",
              "minimum": 0
            },
            "Unknown": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "Providers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "MicrosoftProvided",
            "ThirdParty",
            "Unknown"
          ],
          "properties": {
            "MicrosoftProvided": {
              "type": "integer",
              "minimum": 0
            },
            "ThirdParty": {
              "type": "integer",
              "minimum": 0
            },
            "Unknown": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "Technologies": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "MicrosoftIppClassDriver",
            "UniversalPrintClassDriver"
          ],
          "properties": {
            "MicrosoftIppClassDriver": {
              "type": "integer",
              "minimum": 0
            },
            "UniversalPrintClassDriver": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "networkProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "NetworkCategory",
        "IPv4Connectivity",
        "IPv6Connectivity"
      ],
      "properties": {
        "NetworkCategory": {
          "type": "string"
        },
        "IPv4Connectivity": {
          "type": "string"
        },
        "IPv6Connectivity": {
          "type": "string"
        }
      }
    },
    "registryState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Present",
        "Value",
        "Kind"
      ],
      "properties": {
        "Present": {
          "type": "boolean"
        },
        "Value": {
          "type": [
            "string",
            "integer",
            "number",
            "boolean",
            "array",
            "null"
          ],
          "items": {
            "type": [
              "string",
              "integer",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "Kind": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "wpp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Enabled",
        "GroupPolicy",
        "Mode",
        "EnabledBy"
