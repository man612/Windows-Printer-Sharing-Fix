        "GroupPolicy": {
          "$ref": "#/$defs/registryState"
        },
        "Mode": {
          "$ref": "#/$defs/registryState"
        },
        "EnabledBy": {
          "$ref": "#/$defs/registryState"
        }
      }
    },
    "wppReadiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "OsSupportsWpp",
        "WppEnabled",
        "EvidenceScope",
        "LocalBindingState",
        "TotalBindings",
        "KnownWindowsReadyPrintBindings",
        "MicrosoftIppClassDriverBindings",
        "UniversalPrintClassDriverBindings",
        "ThirdPartyDriverBindings",
        "UnknownOrOtherBindings",
        "DeviceCompatibilityProven"
      ],
      "properties": {
        "OsSupportsWpp": {
          "type": "boolean"
        },
        "WppEnabled": {
          "type": "boolean"
        },
        "EvidenceScope": {
          "const": "InstalledPrinterBindingsOnly"
        },
        "LocalBindingState": {
          "enum": [
            "NoInstalledPrinters",
            "WindowsReadyPrintBindingsOnly",
            "ThirdPartyDriverDependenciesPresent",
            "MixedOrUnknown"
          ]
