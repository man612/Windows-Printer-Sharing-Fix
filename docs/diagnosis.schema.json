{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/man612/Windows-Printer-Sharing-Fix/main/docs/diagnosis.schema.json",
  "title": "Windows Printer Sharing Fix sanitized diagnosis",
  "description": "Machine-validatable schema for windows-printer-sharing-fix/diagnosis schema version 1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Schema",
    "SchemaVersion",
    "ToolVersion",
    "CollectedAtUtc",
    "ExportedAtUtc",
    "Language",
    "Sanitized",
    "Privacy",
    "Windows",
    "Role",
    "Spooler",
    "PrinterSummary",
    "DriverSummary",
    "NetworkProfiles",
    "WPP",
    "SmbSecurity",
    "Policies",
    "PolicySources",
    "NextInvestigation",
    "SMB1Client",
    "PrintServiceEvents",
    "Findings",
    "TimingMs",
    "TargetPath",
    "FunctionalVerification"
  ],
  "properties": {
    "Schema": {
      "const": "windows-printer-sharing-fix/diagnosis"
    },
    "SchemaVersion": {
      "const": 1
    },
    "ToolVersion": {
      "type": "string",
      "minLength": 1
    },
    "CollectedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "ExportedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "Language": {
      "enum": [
        "EN",
        "ID"
      ]
    },
    "Sanitized": {
      "const": true
    },
    "Privacy": {
      "type": "string",
      "minLength": 1
    },
    "Windows": {
      "$ref": "#/$defs/windows"
    },
    "Role": {
      "type": "string",
      "minLength": 1
    },
    "Spooler": {
      "$ref": "#/$defs/spooler"
    },
    "PrinterSummary": {
      "$ref": "#/$defs/printerSummary"
    },
    "DriverSummary": {
      "$ref": "#/$defs/driverSummary"
    },
    "NetworkProfiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/networkProfile"
      }
    },
    "WPP": {
      "$ref": "#/$defs/wpp"
    },
    "WppReadiness": {
      "$ref": "#/$defs/wppReadiness"
    },
    "SmbSecurity": {
      "$ref": "#/$defs/smbSecurity"
    },
    "Policies": {
      "$ref": "#/$defs/policies"
    },
    "PolicySources": {
      "$ref": "#/$defs/policySources"
    },
    "NextInvestigation": {
      "$ref": "#/$defs/nextInvestigation"
    },
    "SMB1Client": {
      "type": "string"
    },
    "PrintServiceEvents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/printServiceEvent"
      }
    },
    "Findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "TimingMs": {
      "$ref": "#/$defs/timing"
    },
    "TargetPath": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/targetPath"
        }
      ]
    },
    "FunctionalVerification": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/functionalVerification"
        }
      ]
    }
  },
  "$defs": {
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Name",
        "DisplayVersion",
        "Build",
        "Revision",
        "FullBuild",
        "InstallationType",
        "IsServer",
        "PowerShell"
      ],
      "properties": {
        "Name": {
          "type": "string",
          "minLength": 1
        },
        "DisplayVersion": {
          "type": "string"
        },
        "Build": {
          "type": "integer",
          "minimum": 0
        },
        "Revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "FullBuild": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
        },
        "InstallationType": {
          "type": "string"
        },
        "IsServer": {
          "type": "boolean"
        },
        "PowerShell": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "spooler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Present",
        "Status"
      ],
      "properties": {
        "Present": {
          "type": "boolean"
        },
        "Status": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "printerSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Total",
        "Shared",
        "NetworkConnections"
