        "RpcProtocols": {
          "$ref": "#/$defs/registryState"
        },
        "RpcTcpPort": {
          "$ref": "#/$defs/registryState"
        },
        "ForceKerberosForRpc": {
          "$ref": "#/$defs/registryState"
        },
        "RemoteRpcEndpoint": {
          "$ref": "#/$defs/registryState"
        },
        "PointAndPrint": {
          "$ref": "#/$defs/registryState"
        },
        "GuestAuth": {
          "$ref": "#/$defs/registryState"
        },
        "LmCompatibility": {
          "$ref": "#/$defs/registryState"
        },
        "BlankPassword": {
          "$ref": "#/$defs/registryState"
        }
      }
    },
    "policySource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Configured",
        "Source",
        "Evidence"
      ],
      "properties": {
        "Configured": {
          "type": "boolean"
        },
        "Source": {
          "enum": [
            "LocalGroupPolicy",
            "GroupPolicy",
            "PossibleMdmOrOtherPolicy",
            "RegistryOnlyOrUnknownSource",
            "NotConfigured"
          ]
        },
        "Evidence": {
          "type": "string"
        }
      }
    },
    "policySources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "RpcPrivacy",
        "RpcUseNamedPipe",
        "RpcProtocols",
        "RpcTcpPort",
        "ForceKerberosForRpc",
        "RemoteRpcEndpoint",
        "PointAndPrint",
        "WppGroupPolicy"
      ],
      "properties": {
        "RpcPrivacy": {
          "$ref": "#/$defs/policySource"
        },
        "RpcUseNamedPipe": {
          "$ref": "#/$defs/policySource"
        },
        "RpcProtocols": {
          "$ref": "#/$defs/policySource"
        },
        "RpcTcpPort": {
          "$ref": "#/$defs/policySource"
        },
        "ForceKerberosForRpc": {
          "$ref": "#/$defs/policySource"
        },
        "RemoteRpcEndpoint": {
          "$ref": "#/$defs/policySource"
        },
        "PointAndPrint": {
          "$ref": "#/$defs/policySource"
        },
        "WppGroupPolicy": {
          "$ref": "#/$defs/policySource"
