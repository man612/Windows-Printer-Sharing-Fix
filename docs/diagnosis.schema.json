      "properties": {
        "Client": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "Available",
            "RequireSigning",
            "RequireEncryption",
            "InsecureGuestAllowed",
            "AuditServerDoesNotSupportSigning",
            "AuditServerDoesNotSupportEncryption"
