        "TotalBindings": {
          "type": "integer",
          "minimum": 0
        },
        "KnownWindowsReadyPrintBindings": {
          "type": "integer",
          "minimum": 0
        },
        "MicrosoftIppClassDriverBindings": {
          "type": "integer",
          "minimum": 0
        },
        "UniversalPrintClassDriverBindings": {
          "type": "integer",
          "minimum": 0
        },
        "ThirdPartyDriverBindings": {
          "type": "integer",
          "minimum": 0
        },
        "UnknownOrOtherBindings": {
          "type": "integer",
          "minimum": 0
        },
        "DeviceCompatibilityProven": {
          "const": false
        }
      }
    },
    "smbSecurity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Client",
        "Server"
